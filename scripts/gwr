#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "Usage: gwr <branch-name>" >&2
	exit 1
fi

branch="$1"

# we have to know repo name to kill session because its named repo/branch

repo_root="$(git rev-parse --path-format=absolute --git-common-dir | sed 's/\/\.git$//')"
repo_name="$(basename "$repo_root")"

# kill tmux session
# tmux disallows . and : in session names (it silently replaces them with _),
# and . in a -t target is parsed as a pane separator
tmux_session="${repo_name}/${branch}"
tmux_session="${tmux_session//[.:]/_}"
tmux kill-session -t "=$tmux_session"

# remove workflow
git worktree remove "$branch"
